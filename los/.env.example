# Browser API base (LOS paths live under Nest `/api/los`).
# Local Docker / host: call Nest on the published port (CORS allows localhost:3020).
NEXT_PUBLIC_API_URL=http://localhost:4001/api/los
# Absolute Nest base for Next server-side fetches / optional `/api/los` rewrite proxy.
# Docker Compose overrides this to http://backend:4001/api/los.
API_SERVER_URL=http://127.0.0.1:4001/api/los
# Optional same-origin proxy: set NEXT_PUBLIC_API_URL=/api/los and keep API_SERVER_URL absolute.
# If `/api/los/*` 404s under Docker, wipe the LOS Next cache volume:
#   docker compose down && docker volume rm moneycash_los-next
#   docker compose up -d --force-recreate los
# Production (browser → API host, or same-origin `/api/los` behind a reverse proxy):
# NEXT_PUBLIC_API_URL=https://api.moneycash.in/api/los
# API_SERVER_URL=https://api.moneycash.in/api/los
# Backend must allow the LOS origin: CORS_ORIGINS=...,https://los.moneycash.in
PORT=3010
# Dev uses Next's default `.next` folder (see next.config.ts). Do not set NEXT_DIST_DIR in dev.
# If you see stale build errors, remove `.next` before restarting: `rm -rf .next`
# Comma-separated hosts for Next dev (no defaults in code)
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
# Base URL of the customer portal — used to build full UTM copy URLs in masters
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=http://localhost:3021

# Sentry (optional — leave unset to disable). Prefer a separate Sentry project from customer.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ORG=your-org
# SENTRY_PROJECT=moneycash-los
# SENTRY_AUTH_TOKEN=sntrys_...
