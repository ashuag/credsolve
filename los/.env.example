# Same pattern as customer: browser calls same-origin `/api/los/*`; Next rewrites to Nest
# (`beforeFiles` in next.config.ts). Docker Compose sets API_SERVER_URL to the backend service.
NEXT_PUBLIC_API_URL=/api/los
# Absolute Nest base for the rewrite proxy + server-side fetches.
# Docker Compose overrides this to http://backend:4001/api/los.
API_SERVER_URL=http://127.0.0.1:4001/api/los
# Production:
# NEXT_PUBLIC_API_URL=/api/los
# API_SERVER_URL=https://api.moneycash.in/api/los
PORT=3010
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=http://localhost:3021
