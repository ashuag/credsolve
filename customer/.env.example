# Browser can use a relative base (`/api`) when Next rewrites to the API; the rewrite layer
# still needs an absolute API_SERVER_URL (see next.config.ts).
# Recommended local: NEXT_PUBLIC_API_URL=/api — avoids CORS (same origin as this app) and avoids https→http mismatch on :4001.
# Production split host (e.g. `https://api.moneycash.in/api` here + customer on `www`): set Nest
# `CUSTOMER_AUTH_COOKIE_DOMAIN=moneycash.in` so the session cookie is visible on both `www` and `api`
# (needed for `/auth/google/login` on the customer origin). See `backend/.env.example`.
# If you set NEXT_PUBLIC_API_URL to an absolute URL, use http://127.0.0.1:4001/api unless Nest is actually served with TLS.
# Never use https://localhost:4001 for the default Nest dev server (plain HTTP) — Firefox shows NS_ERROR_NET_RESET.
NEXT_PUBLIC_API_URL=/api
# Public site URL (no trailing slash). Set in production so server redirects (e.g. Google login errors) use https://www… — Next.js requires absolute URLs; without this, a proxy that sends Host: localhost:3011 can produce wrong Location headers.
# Build-time (inlined): NEXT_PUBLIC_CUSTOMER_PUBLIC_URL=https://www.moneycash.in
# Runtime only (Docker / PM2, no rebuild): CUSTOMER_PUBLIC_URL=https://www.moneycash.in
# Next server-side rewrites `/api/*` to Nest (see next.config.ts). Docker Compose sets `API_SERVER_URL=http://backend:4001/api` for the `customer` service.
# Host-only dev (no Docker): API_SERVER_URL=http://127.0.0.1:4001/api
API_SERVER_URL=http://localhost:4001/api
# Optional: max wait for browser API calls (ms). Defaults: GET 10000, POST 15000.
# Setting NEXT_PUBLIC_API_FETCH_TIMEOUT_MS overrides BOTH GET and POST timeouts.
# NEXT_PUBLIC_API_FETCH_TIMEOUT_MS=
# NEXT_PUBLIC_API_GET_TIMEOUT_MS=10000
# NEXT_PUBLIC_API_POST_TIMEOUT_MS=15000
# Google OAuth start URL is derived from `NEXT_PUBLIC_API_URL` (see `buildGoogleOAuthStartHref`):
# relative `/api` → `/auth/google/login` on this app; absolute `https://api…/api` → `https://api…/api/auth/google/login` so the session cookie on `api` is sent.
# Comma-separated hosts allowed for Next dev cross-origin (no defaults in code)
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.1.104
CUSTOMER_DEMO_INVITE_TOKEN=
# Docker Compose overrides this to `.next` and sets NODE_ENV=development for the customer service.
# Using NODE_ENV=production or a custom NEXT_DIST_DIR without running `next build` in that folder
# causes missing `.next/routes-manifest.json` errors with `next start`.
NEXT_DIST_DIR=.next-local
PORT=3011
