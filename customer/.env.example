# Browser can use a relative base (`/api`) when Next rewrites to the API; the rewrite layer
# still needs an absolute API_SERVER_URL (see next.config.ts).
NEXT_PUBLIC_API_URL=/api
API_SERVER_URL=http://localhost:4001/api
# Proxied to Nest `GET /api/auth/google/login` (requires mobile session cookie).
NEXT_PUBLIC_GOOGLE_LOGIN_URL=/auth/google/login
# Comma-separated hosts allowed for Next dev cross-origin (no defaults in code)
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.1.104
CUSTOMER_DEMO_INVITE_TOKEN=
# Docker Compose overrides this to `.next` and sets NODE_ENV=development for the customer service.
# Using NODE_ENV=production or a custom NEXT_DIST_DIR without running `next build` in that folder
# causes missing `.next/routes-manifest.json` errors with `next start`.
NEXT_DIST_DIR=.next-local
PORT=3011
