{
  "name": "moneyCash-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "dev": "node scripts/run-prisma-cli.cjs generate --config prisma.config.ts && nest start --watch --builder tsc --preserveWatchOutput --no-shell",
    "start": "node build/src/main.js",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "seed:build": "tsc -p tsconfig.seed.json --outDir /tmp/moneyCash-backend-seed",
    "seed": "node scripts/run-prisma-cli.cjs generate --config prisma.config.ts && tsc -p tsconfig.seed.json --outDir /tmp/moneyCash-backend-seed && NODE_PATH=./node_modules node /tmp/moneyCash-backend-seed/prisma/seed.js",
    "prisma:generate": "node scripts/run-prisma-cli.cjs generate --config prisma.config.ts",
    "prisma:validate": "node scripts/run-prisma-cli.cjs validate --config prisma.config.ts",
    "prisma:migrate:deploy": "node scripts/run-prisma-cli.cjs migrate deploy --config prisma.config.ts",
    "prisma:migrate:dev": "node scripts/run-prisma-cli.cjs migrate dev --config prisma.config.ts",
    "prisma:seed": "node scripts/run-prisma-cli.cjs db seed --config prisma.config.ts",
    "loan-docs:build-templates": "node scripts/build-loan-document-pdf-templates.mjs",
    "loan-docs:generate-field-maps": "node scripts/generate-loan-document-field-maps.mjs",
    "nest": "nest"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/adapter-mariadb": "^7.6.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "nodemailer": "6.10.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/helmet": "^0.0.48",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "6.4.23",
    "typescript": "^5.8.3"
  }
}
