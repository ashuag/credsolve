// ============================================================
// CUSTOMER
// ============================================================
//
// Customer identity + KYC. A customer can have many leads/applications
// but at most one active KYC bundle.

model Customer {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String    @unique @default(uuid()) @db.Char(36)
  mobileNumber    String    @unique @map("mobile_number") @db.Char(10)
  kycVerifiedAt   DateTime? @map("kyc_verified_at")
  isBlacklisted   Boolean   @default(false) @map("is_blacklisted")
  /// Set after a successful PAN+DOB NSDL cache row; null on new customers.
  panNsdlCacheId  BigInt?   @map("pan_nsdl_cache_id") @db.UnsignedBigInt
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  panNsdlCache  PanNsdlCache? @relation(fields: [panNsdlCacheId], references: [id], onDelete: SetNull)
  leads         Lead[]
  applications  Application[]
  customerKycs  CustomerKyc[]
  bureauReports BureauReport[]
  loanAccounts  LoanAccount[]

  @@index([panNsdlCacheId])
  @@index([createdAt])
  @@map("customer")
}

model CustomerKyc {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId        BigInt    @map("customer_id") @db.UnsignedBigInt
  panCardNumber     String?   @map("pan_card_number") @db.Char(10)
  panCardVerifiedAt DateTime? @map("pan_card_verified_at") @db.DateTime(3)
  aadhaarVerifiedAt DateTime? @map("aadhaar_verified_at") @db.DateTime(3)
  aadhaarData       Json?     @map("aadhaar_data")
  aadhaarPhotoPath  String?   @map("aadhaar_photo_path") @db.VarChar(512)
  /** `1` DigiLocker, `2` OTP based — how Aadhaar KYC was captured. */
  aadhaarKycType    Int?      @map("aadhaar_kyc_type") @db.SmallInt
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([panCardNumber])
  @@map("customer_kyc")
}
