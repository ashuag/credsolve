// ============================================================
// LOAN ACCOUNT & REPAYMENTS
// ============================================================
//
// `loan_account` is created at disbursement (one per application).
// `loan_number` and `loan_account_number` are set from `lead.lead_id`
// via `application.application_number` (see resolveLoanAccountNumberAtDisbursement).
// `loan_repayment` records individual payment events against an account.

model LoanAccount {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                 String    @unique @default(uuid()) @db.Char(36)
  applicationId        BigInt    @unique @map("application_id") @db.UnsignedBigInt
  customerId           BigInt    @map("customer_id") @db.UnsignedBigInt
  /// Public loan reference — same value as `lead.lead_id` / `application.application_number` (e.g. APP2026K7M2Q).
  loanNumber           String    @unique @map("loan_number") @db.VarChar(12)
  loanAccountNumber    String    @unique @map("loan_account_number") @db.VarChar(30)
  principalAmount      Decimal   @map("principal_amount") @db.Decimal(12, 2)
  netDisbursedAmount   Decimal   @map("net_disbursed_amount") @db.Decimal(12, 2)
  interestRate         Decimal   @map("interest_rate") @db.Decimal(5, 2)
  interestAmount       Decimal   @map("interest_amount") @db.Decimal(12, 2)
  totalRepaymentAmount Decimal   @map("total_repayment_amount") @db.Decimal(12, 2)
  disbursedAt          DateTime  @map("disbursed_at") @db.DateTime(3)
  loanMaturityDate     DateTime  @map("loan_maturity_date") @db.Date
  utr                  String?   @db.VarChar(50)
  /// Easebuzz quick-transfer response body (or `data.transfer_request`) saved at disbursement.
  gatewayTransferJson  Json?     @map("gateway_transfer_json")
  bankAccountNumber    String?   @map("bank_account_number") @db.VarChar(20)
  ifscCode             String?   @map("ifsc_code") @db.VarChar(11)
  loanStatusId         Int       @map("loan_status_id") @db.SmallInt
  closedAt             DateTime? @map("closed_at") @db.DateTime(3)
  /// True after NOC / loan-closure PDF was uploaded to S3 (email is best-effort after that).
  isNocSent            Boolean   @default(false) @map("is_noc_sent")
  nocSentAt            DateTime? @map("noc_sent_at") @db.DateTime(3)
  nocPdfRelativePath   String?   @map("noc_pdf_relative_path") @db.VarChar(512)
  /// Printed letter number: `{loanNumber}{YYYYMMDDHHmmss}` (IST).
  nocLetterNumber      String?   @unique @map("noc_letter_number") @db.VarChar(40)
  /// Waiver of negotiable overdue charges (penal + overdue-days interest). Does not reduce principal or tenure interest.
  waivedAmount         Decimal   @default(0) @map("waived_amount") @db.Decimal(12, 2)
  waivedByUserId       BigInt?   @map("waived_by_user_id") @db.UnsignedBigInt
  waivedAt             DateTime? @map("waived_at") @db.DateTime(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  application               Application                       @relation(fields: [applicationId], references: [id])
  customer                  Customer                          @relation(fields: [customerId], references: [id])
  loanStatus                LoanStatus                        @relation(fields: [loanStatusId], references: [id])
  waivedByUser              User?                             @relation("LoanChargeWaivedBy", fields: [waivedByUserId], references: [id], onDelete: SetNull)
  repayments                LoanRepayment[]
  easebuzzNotifications     EasebuzzRepaymentNotification[]

  @@index([customerId, loanStatusId])
  @@index([disbursedAt])
  @@index([loanStatusId, closedAt, loanMaturityDate])
  @@index([waivedByUserId])
  @@map("loan_account")
}

model LoanRepayment {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid           String                   @unique @default(uuid()) @db.Char(36)
  loanAccountId  BigInt                   @map("loan_account_id") @db.UnsignedBigInt
  amount         Decimal                  @db.Decimal(12, 2)
  paymentMode    LoanRepaymentPaymentMode @map("payment_mode")
  status         LoanRepaymentStatus      @default(SUCCESS)
  utr            String?                  @db.VarChar(50)
  failureMessage String?                  @map("failure_message") @db.VarChar(500)
  vendorRef      String?                  @map("vendor_ref") @db.VarChar(64)
  paidAt         DateTime                 @map("paid_at") @db.DateTime(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.DateTime(3)

  loanAccount LoanAccount @relation(fields: [loanAccountId], references: [id])

  @@index([loanAccountId, paidAt])
  @@index([loanAccountId, status])
  @@index([vendorRef, status])
  @@map("loan_repayment")
}

/// Inbound Easebuzz Pay webhook / surl / furl payload plus Transaction V2.1 confirm.
/// Use this table to inspect what Easebuzz sent and whether we confirmed it.
model EasebuzzRepaymentNotification {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid           String    @unique @default(uuid()) @db.Char(36)
  /// webhook | surl | furl
  source         String    @db.VarChar(20)
  txnid          String    @default("") @db.VarChar(64)
  easepayid      String?   @db.VarChar(64)
  status         String?   @db.VarChar(40)
  amount         String?   @db.VarChar(20)
  loanAccountId  BigInt?   @map("loan_account_id") @db.UnsignedBigInt
  /// Exact inbound query+body from Easebuzz (same data they posted).
  payload        Json
  /// Transaction V2.1 retrieve used to confirm the payment.
  confirmPayload Json?     @map("confirm_payload")
  processResult  String?   @map("process_result") @db.VarChar(20)
  processCode    String?   @map("process_code") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  loanAccount LoanAccount? @relation(fields: [loanAccountId], references: [id], onDelete: SetNull)

  @@index([txnid, createdAt])
  @@index([source, createdAt])
  @@index([processResult, createdAt])
  @@index([loanAccountId, createdAt])
  @@map("easebuzz_repayment_notification")
}
