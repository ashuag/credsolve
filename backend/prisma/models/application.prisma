// ============================================================
// APPLICATION
// ============================================================

model Application {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                  String    @unique @default(uuid()) @db.Char(36)
  /// Public alphanumeric reference (exactly 12 chars, e.g. APP2026K7M2Q). Same value as `lead.lead_id`; becomes loan_number at disbursement.
  applicationNumber     String    @unique @map("application_number") @db.VarChar(12)
  customerId            BigInt    @map("customer_id") @db.UnsignedBigInt
  leadId                BigInt    @map("lead_id") @db.UnsignedBigInt
  applicationStatusId   Int       @map("application_status_id") @db.SmallInt
  preApprovedLoanAmount Decimal?  @map("pre_approved_loan_amount") @db.Decimal(12, 2)
  applicationStatusNote String?   @map("application_status_note") @db.VarChar(256)
  rejectionReasonId     Int?      @map("rejection_reason_id") @db.SmallInt
  createdAt             DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customer          Customer              @relation(fields: [customerId], references: [id])
  lead              Lead                  @relation(fields: [leadId], references: [id])
  applicationStatus ApplicationStatus     @relation(fields: [applicationStatusId], references: [id])
  rejectionReason   RejectionReason?      @relation(fields: [rejectionReasonId], references: [id])
  details           ApplicationDetail?
  kyc               ApplicationKyc?
  references        ApplicationReference[]
  loanAccount       LoanAccount?
  bankAccountDetails ApplicationBankAccountDetail[]

  @@index([customerId, applicationStatusId])
  @@index([leadId, createdAt])
  @@index([leadId, applicationStatusId])
  @@index([applicationStatusId])
  @@index([rejectionReasonId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("application")
}

model ApplicationDetail {
  id                           BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  applicationId                BigInt                 @unique @map("application_id") @db.UnsignedBigInt
  emailId                      String?                @map("email_id") @db.VarChar(150)
  emailVerificationType        EmailVerificationType? @map("email_verification_type")
  emailVerifiedAt              DateTime?              @map("email_verified_at") @db.DateTime(3)
  selectedLoanAmount           Decimal?               @map("selected_loan_amount") @db.Decimal(12, 2)
  interestRate                 Decimal?               @map("interest_rate") @db.Decimal(5, 2)
  processingFeePercentage      Decimal?               @map("processing_fee_percentage") @db.Decimal(5, 2)
  gstPercentage                Decimal?               @map("gst_percentage") @db.Decimal(5, 2)
  reasonForLoanId              Int?                   @map("reason_for_loan_id") @db.SmallInt
  expectedRepaymentDays        Int?                   @map("expected_repayment_days") @db.MediumInt
  expectedRepaymentDate        DateTime?              @map("expected_repayment_date") @db.Date
  bankAccountNumber            String?                @map("bank_account_number") @db.VarChar(20)
  ifscCode                     String?                @map("ifsc_code") @db.VarChar(11)
  bankName                     String?                @map("bank_name") @db.VarChar(100)
  keyFactPdfRelativePath       String?                @map("key_fact_pdf_relative_path") @db.VarChar(512)
  keyFactEsigned               Boolean                @default(false) @map("key_fact_esigned")
  /// Final revised KFS written at disbursement (acceptance copy stays in keyFactPdfRelativePath).
  keyFactDisbursementPdfRelativePath String?          @map("key_fact_disbursement_pdf_relative_path") @db.VarChar(512)
  keyFactDisbursementEsigned   Boolean                @default(false) @map("key_fact_disbursement_esigned")
  loanAgreementPdfRelativePath String?                @map("loan_agreement_pdf_relative_path") @db.VarChar(512)
  loanDocumentsAcceptedAt      DateTime?              @map("loan_documents_accepted_at") @db.DateTime(3)
  loanDocumentsAcceptedIp      String?                @map("loan_documents_accepted_ip") @db.VarChar(45)
  /// Customer agreed to loan docs on /loan-documents (no OTP). OTP acceptance is loanDocumentsAcceptedAt.
  loanDocumentsReviewedAt      DateTime?              @map("loan_documents_reviewed_at") @db.DateTime(3)
  loanDocumentsReviewedIp      String?                @map("loan_documents_reviewed_ip") @db.VarChar(45)
  pennyDropAttempts            Int                    @default(0) @map("penny_drop_attempts") @db.SmallInt
  pennyDropVendorJson          Json?                  @map("penny_drop_vendor_json")
  createdAt                    DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                    DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  application   Application    @relation(fields: [applicationId], references: [id])
  reasonForLoan ReasonForLoan? @relation(fields: [reasonForLoanId], references: [id])

  @@map("application_detail")
}

model ApplicationKyc {
  id                          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  applicationId               BigInt    @unique @map("application_id") @db.UnsignedBigInt
  kycStatus                   Int       @default(0) @map("kyc_status") @db.SmallInt
  livenessSelfiePath          String?   @map("liveness_selfie_path") @db.VarChar(512)
  isLiveness                  Boolean   @default(false) @map("is_liveness")
  livenessCheckedAt           DateTime? @map("liveness_checked_at") @db.DateTime(3)
  livenessDoneAt              DateTime? @map("liveness_done_at") @db.DateTime(3)
  livenessPassed              Boolean   @default(false) @map("liveness_passed")
  livenessVendorJson          Json?     @map("liveness_vendor_json")
  livenessVideoPath           String?   @map("liveness_video_path") @db.VarChar(512)
  faceMatchCheckedAt          DateTime? @map("face_match_checked_at") @db.DateTime(3)
  selfieFaceValidationJson       Json?     @map("selfie_face_validation_json")
  selfieFaceValidationPassed     Boolean   @default(false) @map("selfie_face_validation_passed")
  digilockerAadhaarDownloadAttempts Int  @default(0) @map("digilocker_aadhaar_download_attempts") @db.SmallInt
  livenessAttempts               Int       @default(0) @map("liveness_attempts") @db.SmallInt
  kycCompletedAt                 DateTime? @map("kyc_completed_at") @db.DateTime(3)
  createdAt                      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  application Application @relation(fields: [applicationId], references: [id])

  @@index([kycStatus, livenessPassed])
  @@map("application_kyc")
}

model ApplicationReference {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  applicationId  BigInt   @map("application_id") @db.UnsignedBigInt
  referenceIndex Int      @map("reference_index") @db.SmallInt
  fullName       String   @map("full_name") @db.VarChar(100)
  mobileNumber   String   @map("mobile_number") @db.VarChar(10)
  relationId     Int      @map("relation_id") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  application Application       @relation(fields: [applicationId], references: [id])
  relation    ReferenceRelation @relation(fields: [relationId], references: [id])

  @@unique([applicationId, referenceIndex])
  @@index([applicationId])
  @@map("application_reference")
}

model ApplicationBankAccountDetail {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  applicationId       BigInt   @map("application_id") @db.UnsignedBigInt
  bankAccountNumber   String   @map("bank_account_number") @db.VarChar(20)
  ifscCode            String   @map("ifsc_code") @db.VarChar(11)
  bankName            String?  @map("bank_name") @db.VarChar(100)
  accountHolderName   String?  @map("account_holder_name") @db.VarChar(100)
  /// Account-holder name returned by the penny-drop vendor, when present.
  nameAtBank          String?  @map("name_at_bank") @db.VarChar(150)
  /// True when penny-drop and name match succeeded.
  status              Boolean
  pennyDropVendorJson Json?    @map("penny_drop_vendor_json")
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId, createdAt])
  @@index([applicationId, status])
  @@map("application_bank_account_detail")
}
