// ============================================================
// ADMIN / USER (LOS back-office)
// ============================================================
//
// Internal CRM/LOS operators and the role tree they belong to.
// Self-referential `manager` -> `reportees` models the org hierarchy.

model UserRole {
  id             Int     @id @default(autoincrement()) @db.SmallInt
  name           String  @unique @db.VarChar(50)
  hierarchyLevel Int     @default(1) @map("hierarchy_level") @db.SmallInt
  isActive       Boolean @map("is_active") @db.TinyInt
  users          User[]

  @@index([hierarchyLevel])
  @@map("user_role")
}

model User {
  id                      BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  fullName                String    @map("full_name") @db.VarChar(100)
  email                   String    @unique @db.VarChar(150)
  password                String?   @db.VarChar(255)
  roleId                  Int       @map("role_id") @db.SmallInt
  managerId               BigInt?   @map("manager_id") @db.UnsignedBigInt
  isActive                Boolean   @default(true) @map("is_active")
  invitationTokenHash     String?   @unique @map("invitation_token_hash") @db.Char(64)
  invitationSentAt        DateTime? @map("invitation_sent_at")
  invitationExpiresAt     DateTime? @map("invitation_expires_at")
  registrationCompletedAt DateTime? @map("registration_completed_at")
  lastLoginAt             DateTime? @map("last_login_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  userRole  UserRole? @relation(fields: [roleId], references: [id])
  manager   User?     @relation("LosUserManagers", fields: [managerId], references: [id])
  reportees User[]    @relation("LosUserManagers")

  @@index([managerId])
  @@index([roleId])
  @@index([isActive])
  @@map("user")
}
