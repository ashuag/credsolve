model Lead {
  id                                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                              String    @unique @default(uuid()) @db.Char(36)
  /// Public journey ID (exactly 12 chars, e.g. APP2026K7M2Q). Copied to application_number and loan_number.
  leadNumber                        String    @unique @map("lead_id") @db.VarChar(12)
  customerId                        BigInt    @map("customer_id") @db.UnsignedBigInt
  leadStatusId                      Int       @default(1) @map("lead_status_id") @db.SmallInt
  leadStatusNote                    String?   @map("lead_status_note") @db.VarChar(256)
  rejectionReasonId                 Int?      @map("rejection_reason_id") @db.SmallInt
  sourceId                          Int?      @map("source_id")
  isActive                          Boolean   @default(true) @map("is_active")
  isInternalTesting                 Boolean   @default(false) @map("is_internal_testing")
  expiredAt                         DateTime? @map("expired_at")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  customer        Customer         @relation(fields: [customerId], references: [id])
  leadStatus      LeadStatus       @relation(fields: [leadStatusId], references: [id])
  rejectionReason RejectionReason? @relation(fields: [rejectionReasonId], references: [id])
  source          LeadSource?      @relation(fields: [sourceId], references: [id])
  leadDetail      LeadDetail?
  leadUtms        LeadUtm[]
  applications    Application[]
  vendorApiLogs   VendorApiLog[]
  bureauReports   BureauReport[]

  @@index([customerId, createdAt])
  @@index([leadStatusId])
  @@index([rejectionReasonId])
  @@index([sourceId])
  @@index([expiredAt])
  @@index([createdAt])
  @@index([isInternalTesting])
  @@index([isActive, isInternalTesting, createdAt])
  @@index([isActive, leadStatusId])
  @@index([isActive, createdAt])
  @@map("lead")
}

model LeadDetail {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid             String    @unique @default(uuid()) @db.Char(36)
  leadId           BigInt    @unique @map("lead_id") @db.UnsignedBigInt
  fullName         String?   @map("full_name") @db.VarChar(100)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  genderId         Int?      @map("gender_id") @db.SmallInt
  cityId           Int?      @map("city_id")
  pincode          String?   @db.Char(6)
  addressLine1     String?   @map("address_line_1") @db.TinyText
  addressLine2     String?   @map("address_line_2") @db.TinyText
  occupationId     Int?      @map("occupation_id") @db.SmallInt
  netMonthlyIncome Decimal?  @map("net_monthly_income") @db.Decimal(12, 2)
  annualTurnover   Decimal?  @map("annual_turnover") @db.Decimal(12, 2)
  annualProfit     Decimal?  @map("annual_profit") @db.Decimal(12, 2)
  cibilConsentAt        DateTime? @map("cibil_consent_at")
  panNumber             String?   @map("pan_number") @db.Char(10)
  panVerified           Int       @default(0) @map("pan_verified") @db.SmallInt
  panVerifiedAt         DateTime? @map("pan_verified_at")
  panValidationAttempts Int       @default(0) @map("pan_validation_attempts") @db.SmallInt
  bureauFetched         Int       @default(0) @map("bureau_fetched") @db.SmallInt
  bureauFetchedAt       DateTime? @map("bureau_fetched_at")
  bureauFetchedNote     String?   @map("bureau_fetched_note") @db.VarChar(500)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  lead       Lead        @relation(fields: [leadId], references: [id])
  gender     Gender?     @relation(fields: [genderId], references: [id])
  occupation Occupation? @relation(fields: [occupationId], references: [id])
  city       City?       @relation(fields: [cityId], references: [id])

  @@index([cityId])
  @@index([pincode])
  @@index([panVerified, panVerifiedAt])
  @@index([panNumber])
  @@map("lead_detail")
}

/// External vendor HTTP calls (Tenacio, etc.) for audit and debugging.
model VendorApiLog {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String           @unique @default(uuid()) @db.Char(36)
  providerName    String           @map("provider_name") @db.VarChar(100)
  serviceName     String           @map("service_name") @db.VarChar(120)
  requestMethod   VendorHttpMethod @map("request_method")
  /// Outbound request URL (scheme + host + path + query); `VendorApiService` caps length when persisting.
  requestPath     String?          @map("request_path") @db.Text
  leadId          BigInt?          @map("lead_id") @db.UnsignedBigInt
  /// Outbound request headers (sensitive values redacted by VendorApiService).
  requestHeaders  Json?            @map("request_headers")
  requestPayload  Json             @map("request_payload")
  responsePayload Json?            @map("response_payload")
  httpStatus      Int?             @map("http_status")
  requestedAt     DateTime         @map("requested_at")
  respondedAt     DateTime         @map("responded_at")

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([leadId, serviceName, respondedAt])
  @@index([providerName, requestedAt])
  @@index([requestedAt])
  @@index([httpStatus, requestedAt])
  @@map("vendor_api_log")
}

model LeadUtm {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid        String   @unique @default(uuid()) @db.Char(36)
  leadId      BigInt   @map("lead_id") @db.UnsignedBigInt
  utmSource   String?  @map("utm_source") @db.VarChar(100)
  utmMedium   String?  @map("utm_medium") @db.VarChar(100)
  utmCampaign String?  @map("utm_campaign") @db.VarChar(100)
  utmTerm     String?  @map("utm_term") @db.VarChar(100)
  utmContent  String?  @map("utm_content") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_utm")
}
