// ============================================================
// CONFIG / RULES
// ============================================================
//
// Admin-controlled singleton-ish tables: runtime settings, eligibility
// rules, credit-limit tiers. Read by the auth/loans/eligibility modules.

model Setting {
  id          Int      @id @default(autoincrement()) @db.SmallInt
  key         String   @unique @db.VarChar(100)
  value       String   @db.VarChar(255)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("setting")
}

model EligibilityCriteria {
  id          Int      @id @default(autoincrement()) @db.SmallInt
  key         String   @unique @db.VarChar(100)
  label       String   @db.VarChar(200)
  value       String   @db.VarChar(100)
  breType     String   @default("PRE_BRE") @map("bre_type") @db.VarChar(20)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("eligibility_criteria")
}

model CreditLimitTier {
  id               Int      @id @default(autoincrement()) @db.SmallInt
  minUnsecuredLoan Int      @map("min_unsecured_loan")
  maxUnsecuredLoan Int?     @map("max_unsecured_loan")
  maxBulletLoan    Int      @map("max_bullet_loan")
  sortOrder        Int      @default(0) @map("sort_order") @db.SmallInt
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("credit_limit_tier")
}

model SmsTemplate {
  id          Int      @id @default(autoincrement()) @db.SmallInt
  templateId  String   @unique @map("template_id") @db.VarChar(40)
  bearerToken String   @map("bearer_token") @db.VarChar(255)
  message     String   @db.VarChar(500)
  product     String   @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sms_template")
}

/// Registry of vendor APIs (primary + backup) with on/off status for LOS control.
model VendorApiConfig {
  id         Int      @id @default(autoincrement())
  apiCode    String   @map("api_code") @db.VarChar(64)
  apiName    String   @map("api_name") @db.VarChar(120)
  vendorName String   @map("vendor_name") @db.VarChar(80)
  priority   Int      @default(1) @db.SmallInt
  status     String   @default("ACTIVE") @db.VarChar(20)
  notes      String?  @db.VarChar(255)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([apiCode, vendorName], map: "vendor_api_config_api_vendor_uq")
  @@index([apiCode, status, priority], map: "vendor_api_config_api_status_priority_idx")
  @@map("vendor_api_config")
}
