// ============================================================
// GEOGRAPHY / SERVICEABILITY
// ============================================================
//
// State + city masters and the negative flags used by serviceability
// rules during lead origination.

model State {
  id                      Int       @id @default(autoincrement())
  name                    String    @unique @db.VarChar(100)
  code                    String    @unique @db.VarChar(5)
  isActive                Boolean   @default(true) @map("is_active")
  isNegative              Boolean   @default(false) @map("is_negative")
  negativeReason          String?   @map("negative_reason") @db.VarChar(500)
  negativeAddedByUserId   BigInt?   @map("negative_added_by_user_id") @db.UnsignedBigInt
  negativeAddedAt         DateTime? @map("negative_added_at")
  negativeRemovedByUserId BigInt?   @map("negative_removed_by_user_id") @db.UnsignedBigInt
  negativeRemovedAt       DateTime? @map("negative_removed_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  cities                  City[]

  negativeAddedBy   User? @relation("StateNegativeAddedBy", fields: [negativeAddedByUserId], references: [id])
  negativeRemovedBy User? @relation("StateNegativeRemovedBy", fields: [negativeRemovedByUserId], references: [id])

  @@map("state")
}

model City {
  id                      Int       @id @default(autoincrement())
  name                    String    @db.VarChar(100)
  stateId                 Int       @map("state_id")
  /// Legacy id from generic city export (row 1..N); used for pincode bulk import joins.
  sourceCityId            Int?      @unique @map("source_city_id")
  isActive                Boolean   @default(true) @map("is_active")
  isNegative              Boolean   @default(false) @map("is_negative")
  negativeReason          String?   @map("negative_reason") @db.VarChar(500)
  negativeAddedByUserId   BigInt?   @map("negative_added_by_user_id") @db.UnsignedBigInt
  negativeAddedAt         DateTime? @map("negative_added_at")
  negativeRemovedByUserId BigInt?   @map("negative_removed_by_user_id") @db.UnsignedBigInt
  negativeRemovedAt       DateTime? @map("negative_removed_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  state       State        @relation(fields: [stateId], references: [id])
  leadDetails LeadDetail[]
  pincodes    Pincode[]

  negativeAddedBy   User? @relation("CityNegativeAddedBy", fields: [negativeAddedByUserId], references: [id])
  negativeRemovedBy User? @relation("CityNegativeRemovedBy", fields: [negativeRemovedByUserId], references: [id])

  @@unique([name, stateId])
  @@index([stateId])
  @@map("city")
}

/// Indian postal pincode master (6-digit code → city).
model Pincode {
  id                      Int       @id @default(autoincrement())
  code                    String    @unique @db.Char(6)
  cityId                  Int       @map("city_id")
  isActive                Boolean   @default(true) @map("is_active")
  isNegative              Boolean   @default(false) @map("is_negative")
  negativeReason          String?   @map("negative_reason") @db.VarChar(500)
  negativeAddedByUserId   BigInt?   @map("negative_added_by_user_id") @db.UnsignedBigInt
  negativeAddedAt         DateTime? @map("negative_added_at")
  negativeRemovedByUserId BigInt?   @map("negative_removed_by_user_id") @db.UnsignedBigInt
  negativeRemovedAt       DateTime? @map("negative_removed_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  city City @relation(fields: [cityId], references: [id], onDelete: Restrict)

  negativeAddedBy   User? @relation("PincodeNegativeAddedBy", fields: [negativeAddedByUserId], references: [id])
  negativeRemovedBy User? @relation("PincodeNegativeRemovedBy", fields: [negativeRemovedByUserId], references: [id])

  @@index([cityId])
  @@map("pincode")
}
