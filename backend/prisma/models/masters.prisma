// ============================================================
// MASTERS / LOOKUPS
// ============================================================
//
// Small reference tables that act as foreign keys for customer and
// application data (gender, occupation, banks, KYC document types,
// pipeline statuses, etc.). All are admin-managed and rarely change.

model Gender {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  name        String       @unique @db.VarChar(20)
  isActive    Boolean      @default(true) @map("is_active")
  leadDetails LeadDetail[]

  @@map("gender")
}

model Occupation {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  name        String       @unique @db.VarChar(50)
  isActive    Boolean      @default(true) @map("is_active")
  leadDetails LeadDetail[]

  @@map("occupation")
}

model ReferenceRelation {
  id             Int             @id @default(autoincrement()) @db.SmallInt
  name           String          @unique @db.VarChar(50)
  isActive       Boolean         @default(true) @map("is_active")
  leadReferences LeadReference[]

  @@map("reference_relation")
}

model Bank {
  id        Int      @id @default(autoincrement()) @db.SmallInt
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bank")
}

model ReasonForLoan {
  id                 Int                  @id @default(autoincrement()) @db.SmallInt
  name               String               @unique @db.VarChar(50)
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at")
  applicationDetails ApplicationDetails[]

  @@map("reason_for_loan")
}

model OtpType {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  name        String       @unique @db.VarChar(20)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  otpRequests OtpRequest[]

  @@map("otp_type")
}

model KycProvider {
  id                   Int                   @id @default(autoincrement()) @db.SmallInt
  name                 String                @unique @db.VarChar(50)
  displayName          String                @map("display_name") @db.VarChar(50)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  customerKycDocuments CustomerKycDocument[]

  @@map("kyc_provider")
}

model KycDocument {
  id                   Int                   @id @default(autoincrement()) @db.SmallInt
  name                 String                @unique @db.VarChar(50)
  displayName          String                @map("display_name") @db.VarChar(50)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  customerKycDocuments CustomerKycDocument[]

  @@map("kyc_document")
}

model LeadSource {
  id           Int            @id @default(autoincrement())
  name         String         @unique @db.VarChar(50)
  type         LeadSourceType
  isActive     Boolean        @default(true) @map("is_active")
  leads        Lead[]
  utmSources   UtmSource[]
  utmMediums   UtmMedium[]
  utmCampaigns UtmCampaign[]

  @@map("lead_source")
}

/// Allowed `utm_source` tag values per LOS lead source (e.g. google, meta).
model UtmSource {
  id           Int      @id @default(autoincrement()) @db.SmallInt
  leadSourceId Int      @map("lead_source_id")
  name         String   @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  leadSource LeadSource @relation(fields: [leadSourceId], references: [id])

  @@unique([leadSourceId, name])
  @@index([leadSourceId])
  @@map("utm_source")
}

/// Allowed `utm_medium` tag values per LOS lead source (e.g. cpc, email).
model UtmMedium {
  id           Int      @id @default(autoincrement()) @db.SmallInt
  leadSourceId Int      @map("lead_source_id")
  name         String   @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  leadSource LeadSource @relation(fields: [leadSourceId], references: [id])

  @@unique([leadSourceId, name])
  @@index([leadSourceId])
  @@map("utm_medium")
}

/// Allowed `utm_campaign` tag values per LOS lead source.
model UtmCampaign {
  id           Int      @id @default(autoincrement()) @db.SmallInt
  leadSourceId Int      @map("lead_source_id")
  name         String   @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  leadSource LeadSource @relation(fields: [leadSourceId], references: [id])

  @@unique([leadSourceId, name])
  @@index([leadSourceId])
  @@map("utm_campaign")
}

model LeadStatus {
  id          Int     @id @default(autoincrement()) @db.SmallInt
  name        String  @unique @db.VarChar(50)
  displayName String? @map("display_name") @db.VarChar(50)
  isActive    Boolean @default(true) @map("is_active")
  leads       Lead[]

  @@map("lead_status")
}

model RejectionReason {
  id       Int     @id @default(autoincrement()) @db.SmallInt
  name     String  @unique @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")
  leads    Lead[]

  @@map("rejection_reason")
}

model ApplicationStatus {
  id           Int           @id @default(autoincrement()) @db.SmallInt
  name         String        @unique @db.VarChar(20)
  displayName  String?       @map("display_name") @db.VarChar(50)
  isActive     Boolean       @default(true) @map("is_active")
  applications Application[]

  @@map("application_status")
}
