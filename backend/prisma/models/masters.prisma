// ============================================================
// MASTERS / LOOKUPS
// ============================================================
//
// Small reference tables that act as foreign keys for customer and
// application data (gender, occupation, banks, KYC document types,
// pipeline statuses, etc.). All are admin-managed and rarely change.

model Gender {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  name        String       @unique @db.VarChar(20)
  isActive    Boolean      @default(true) @map("is_active")
  leadDetails LeadDetail[]

  @@map("gender")
}

model Occupation {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  name        String       @unique @db.VarChar(50)
  isActive    Boolean      @default(true) @map("is_active")
  leadDetails LeadDetail[]

  @@map("occupation")
}

model Bank {
  id        Int      @id @default(autoincrement()) @db.SmallInt
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bank")
}

model ReasonForLoan {
  id                 Int                  @id @default(autoincrement()) @db.SmallInt
  name               String               @unique @db.VarChar(50)
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at")
  applicationDetails ApplicationDetails[]

  @@map("reason_for_loan")
}

model OtpType {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  name        String       @unique @db.VarChar(20)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  otpRequests OtpRequest[]

  @@map("otp_type")
}

model KycProvider {
  id                   Int                   @id @default(autoincrement()) @db.SmallInt
  name                 String                @unique @db.VarChar(50)
  displayName          String                @map("display_name") @db.VarChar(50)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  customerKycDocuments CustomerKycDocument[]

  @@map("kyc_provider")
}

model KycDocument {
  id                   Int                   @id @default(autoincrement()) @db.SmallInt
  name                 String                @unique @db.VarChar(50)
  displayName          String                @map("display_name") @db.VarChar(50)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  customerKycDocuments CustomerKycDocument[]

  @@map("kyc_document")
}

model LeadSource {
  id       Int            @id @default(autoincrement())
  name     String         @unique @db.VarChar(50)
  type     LeadSourceType
  isActive Boolean        @default(true) @map("is_active")
  leads    Lead[]

  @@map("lead_source")
}

model LeadStatus {
  id          Int     @id @default(autoincrement()) @db.SmallInt
  name        String  @unique @db.VarChar(50)
  displayName String? @map("display_name") @db.VarChar(50)
  isActive    Boolean @default(true) @map("is_active")
  leads       Lead[]

  @@map("lead_status")
}

model ApplicationStatus {
  id           Int           @id @default(autoincrement()) @db.SmallInt
  name         String        @unique @db.VarChar(20)
  displayName  String?       @map("display_name") @db.VarChar(50)
  isActive     Boolean       @default(true) @map("is_active")
  applications Application[]

  @@map("application_status")
}
