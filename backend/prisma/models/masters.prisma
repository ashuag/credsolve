// ============================================================
// MASTERS / LOOKUPS
// ============================================================
//
// Small reference tables that act as foreign keys for customer and
// application data (gender, occupation, banks, KYC document types,
// pipeline statuses, etc.). All are admin-managed and rarely change.

model Gender {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  key         String       @unique @db.VarChar(20)
  name        String       @unique @db.VarChar(20)
  isActive    Boolean      @default(true) @map("is_active")
  leadDetails LeadDetail[]

  @@map("gender")
}

model Occupation {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  key         String       @unique @db.VarChar(50)
  name        String       @unique @db.VarChar(50)
  isActive    Boolean      @default(true) @map("is_active")
  leadDetails LeadDetail[]

  @@map("occupation")
}

model ReferenceRelation {
  id             Int             @id @default(autoincrement()) @db.SmallInt
  name           String          @unique @db.VarChar(50)
  isActive       Boolean         @default(true) @map("is_active")
  applicationReferences ApplicationReference[]

  @@map("reference_relation")
}

model Bank {
  id        Int      @id @default(autoincrement()) @db.SmallInt
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bank")
}

model ReasonForLoan {
  id                Int                 @id @default(autoincrement()) @db.SmallInt
  name              String              @unique @db.VarChar(50)
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  loanDetails           ApplicationDetail[]

  @@map("reason_for_loan")
}

model OtpType {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  name        String       @unique @db.VarChar(20)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  otpRequests OtpRequest[]

  @@map("otp_type")
}

model KycProvider {
  id          Int      @id @default(autoincrement()) @db.SmallInt
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("kyc_provider")
}

model KycDocument {
  id          Int      @id @default(autoincrement()) @db.SmallInt
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("kyc_document")
}

model LeadSource {
  id         Int            @id @default(autoincrement())
  name       String         @unique @db.VarChar(50)
  type       LeadSourceType
  isActive   Boolean        @default(true) @map("is_active")
  leads      Lead[]
  sourceUtms SourceUtm[]

  @@map("lead_source")
}

model SourceUtm {
  id           Int      @id @default(autoincrement()) @db.SmallInt
  leadSourceId Int      @map("lead_source_id")
  utmSource    String?  @map("utm_source") @db.VarChar(100)
  utmCampaign  String?  @map("utm_campaign") @db.VarChar(100)
  utmTerm      String?  @map("utm_term") @db.VarChar(100)
  utmMedium    String?  @map("utm_medium") @db.VarChar(100)
  utmContent   String?  @map("utm_content") @db.VarChar(100)
  createdBy    BigInt?  @map("created_by") @db.UnsignedBigInt
  createdAt    DateTime @default(now()) @map("created_at")
  isActive     Boolean  @default(true) @map("is_active")
  updatedBy    BigInt?  @map("updated_by") @db.UnsignedBigInt
  updatedAt    DateTime @updatedAt @map("updated_at")

  leadSource    LeadSource @relation(fields: [leadSourceId], references: [id])
  createdByUser User?      @relation("SourceUtmCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?      @relation("SourceUtmUpdatedBy", fields: [updatedBy], references: [id])

  @@index([leadSourceId])
  @@map("source_utm")
}

model LeadStatus {
  id          Int     @id @default(autoincrement()) @db.SmallInt
  name        String  @unique @db.VarChar(50)
  displayName String? @map("display_name") @db.VarChar(50)
  isActive    Boolean @default(true) @map("is_active")
  leads       Lead[]

  @@map("lead_status")
}

model RejectionReason {
  id       Int     @id @default(autoincrement()) @db.SmallInt
  name     String  @unique @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")
  leads        Lead[]
  applications Application[]

  @@map("rejection_reason")
}

model ApplicationStatus {
  id           Int           @id @default(autoincrement()) @db.SmallInt
  name         String        @unique @db.VarChar(20)
  displayName  String?       @map("display_name") @db.VarChar(50)
  isActive     Boolean       @default(true) @map("is_active")
  applications Application[]

  @@map("application_status")
}

model LoanStatus {
  id           Int           @id @default(autoincrement()) @db.SmallInt
  name         String        @unique @db.VarChar(20)
  displayName  String?       @map("display_name") @db.VarChar(50)
  isActive     Boolean       @default(true) @map("is_active")
  loanAccounts LoanAccount[]

  @@map("loan_status")
}

/// Month-specific repayment due date override. When active, the due date for
/// that calendar month replaces the default last-day-of-month rule.
model RepaymentDueDate {
  id        Int      @id @default(autoincrement()) @db.SmallInt
  year      Int      @db.SmallInt
  month     Int      @db.SmallInt
  dueDate   DateTime @map("due_date") @db.Date
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([year, month])
  @@map("repayment_due_date")
}
