// ============================================================
// CONTACT
// ============================================================
//
// Messages submitted from the public "Contact Us" form on the
// customer marketing site. Surfaced read-only in the LOS.

model ContactSubmission {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(150)
  email     String   @db.VarChar(190)
  subject   String   @db.VarChar(200)
  message   String   @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([isRead])
  @@map("contact_submission")
}
