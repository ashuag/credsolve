// ============================================================
// PRISMA SCHEMA — ENTRY FILE
// ============================================================
//
// This file owns ONLY the generator + datasource blocks. All enums and
// models are split by domain under `prisma/models/*.prisma`:
//
//   models/enums.prisma         — shared enums
//   models/config.prisma        — Setting, EligibilityCriteria, CreditLimitTier
//   models/masters.prisma       — small reference tables (Gender, Bank, statuses, …)
//   models/geography.prisma     — State, City, NegativeState/City/Pincode
//   models/otp.prisma           — OtpRequest
//   models/customer.prisma      — Customer + KYC
//   models/lead.prisma          — Lead + LeadDetail + UTMs + VendorApiLog (+ BureauReport in bureau-report.prisma)
//   models/application.prisma   — Application + sub-aggregates
//   models/user.prisma          — LOS UserRole + User
//
// Multi-file is enabled by `schema: 'prisma'` (directory, not file) in
// `prisma.config.ts` — required by Prisma 7 (see issue prisma/prisma#28673).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}
