generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum LeadSourceType {
  ADS
  CONNECTOR
  SALES
  ORGANIC
  PARTNER
  API
}

enum EmailVerificationType {
  GOOGLE
  OTP
}

// ============================================================
// LOOKUP / CONFIG TABLES
// ============================================================

model Setting {
  id          Int      @id @default(autoincrement()) @db.SmallInt
  key         String   @unique @db.VarChar(100)
  value       String   @db.VarChar(255)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("setting")
}

model Gender {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  name        String       @unique @db.VarChar(20)
  isActive    Boolean      @default(true) @map("is_active")
  leadDetails LeadDetail[]

  @@map("gender")
}

model Occupation {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  name        String       @unique @db.VarChar(50)
  isActive    Boolean      @default(true) @map("is_active")
  leadDetails LeadDetail[]

  @@map("occupation")
}

model Bank {
  id        Int      @id @default(autoincrement()) @db.SmallInt
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bank")
}

model State {
  id            Int            @id @default(autoincrement())
  name          String         @unique @db.VarChar(100)
  code          String         @unique @db.VarChar(5)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  cities        City[]
  negativeState NegativeState?

  @@map("state")
}

model City {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  stateId   Int      @map("state_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  state        State         @relation(fields: [stateId], references: [id])
  leadDetails  LeadDetail[]
  negativeCity NegativeCity?

  @@unique([name, stateId])
  @@index([stateId])
  @@map("city")
}

/// Serviceability: blocklisted 6-digit Indian pincodes (no FK — pincodes may exist outside `city` master).
model NegativePincode {
  id        Int      @id @default(autoincrement())
  pincode   String   @unique @db.Char(6)
  reason    String?  @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("negative_pincode")
}

/// Serviceability: entire `state` blocked for origination.
model NegativeState {
  id        Int      @id @default(autoincrement())
  stateId   Int      @unique @map("state_id")
  reason    String?  @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@map("negative_state")
}

/// Serviceability: single `city` blocked for origination.
model NegativeCity {
  id        Int      @id @default(autoincrement())
  cityId    Int      @unique @map("city_id")
  reason    String?  @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@map("negative_city")
}

model ReasonForLoan {
  id                 Int                  @id @default(autoincrement()) @db.SmallInt
  name               String               @unique @db.VarChar(50)
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at")
  applicationDetails ApplicationDetails[]

  @@map("reason_for_loan")
}

model OtpType {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  name        String       @unique @db.VarChar(20)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  otpRequests OtpRequest[]

  @@index([isActive])
  @@map("otp_type")
}

model KycProvider {
  id                   Int                   @id @default(autoincrement()) @db.SmallInt
  name                 String                @unique @db.VarChar(50)
  displayName          String                @map("display_name") @db.VarChar(50)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  customerKycDocuments CustomerKycDocument[]

  @@map("kyc_provider")
}

model KycDocument {
  id                   Int                   @id @default(autoincrement()) @db.SmallInt
  name                 String                @unique @db.VarChar(50)
  displayName          String                @map("display_name") @db.VarChar(50)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  customerKycDocuments CustomerKycDocument[]

  @@map("kyc_document")
}

model LeadSource {
  id       Int            @id @default(autoincrement())
  name     String         @unique @db.VarChar(50)
  type     LeadSourceType
  isActive Boolean        @default(true) @map("is_active")
  leads    Lead[]

  @@map("lead_source")
}

model LeadStatus {
  id          Int     @id @default(autoincrement()) @db.SmallInt
  name        String  @unique @db.VarChar(50)
  displayName String? @map("display_name") @db.VarChar(50)
  isActive    Boolean @default(true) @map("is_active")
  leads       Lead[]

  @@map("lead_status")
}

model ApplicationStatus {
  id           Int           @id @default(autoincrement()) @db.SmallInt
  name         String        @unique @db.VarChar(20)
  displayName  String?       @map("display_name") @db.VarChar(50)
  isActive     Boolean       @default(true) @map("is_active")
  applications Application[]

  @@map("application_status")
}

model EligibilityCriteria {
  id          Int      @id @default(autoincrement()) @db.SmallInt
  key         String   @unique @db.VarChar(100)
  label       String   @db.VarChar(200)
  value       String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("eligibility_criteria")
}

model CreditLimitTier {
  id               Int      @id @default(autoincrement()) @db.SmallInt
  minUnsecuredLoan Int      @map("min_unsecured_loan")
  maxUnsecuredLoan Int?     @map("max_unsecured_loan")
  maxBulletLoan    Int      @map("max_bullet_loan")
  sortOrder        Int      @default(0) @map("sort_order") @db.SmallInt
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("credit_limit_tier")
}

// ============================================================
// OTP
// ============================================================

model OtpRequest {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(uuid()) @db.Char(36)
  value        String    @db.VarChar(100)
  typeId       Int       @map("type_id") @db.SmallInt
  otpCode      String    @map("otp_code") @db.VarChar(6)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  attemptCount Int       @default(0) @map("attempt_count") @db.SmallInt
  lastSentAt   DateTime  @default(now()) @map("last_sent_at")
  expiresAt    DateTime  @map("expires_at")
  utmSource    String?   @map("utm_source") @db.VarChar(100)
  utmMedium    String?   @map("utm_medium") @db.VarChar(100)
  utmCampaign  String?   @map("utm_campaign") @db.VarChar(100)
  utmTerm      String?   @map("utm_term") @db.VarChar(100)
  utmContent   String?   @map("utm_content") @db.VarChar(100)
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  type OtpType @relation(fields: [typeId], references: [id])

  @@index([value, typeId])
  @@index([expiresAt])
  @@index([verifiedAt])
  @@map("otp_request")
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique @default(uuid()) @db.Char(36)
  mobileNumber  String    @unique @map("mobile_number") @db.Char(10)
  kycVerifiedAt DateTime? @map("kyc_verified_at")
  isBlacklisted Boolean   @default(false) @map("is_blacklisted")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  leads        Lead[]
  applications Application[]
  customerKycs CustomerKyc[]

  @@map("customer")
}

model CustomerKyc {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique @default(uuid()) @db.Char(36)
  customerId    BigInt    @map("customer_id") @db.UnsignedBigInt
  panNumber     String?   @map("pan_number") @db.Char(10)
  panVerifiedAt DateTime? @map("pan_verified_at")
  fullName      String?   @map("full_name") @db.VarChar(100)
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  kycVerifiedAt DateTime? @map("kyc_verified_at")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer             Customer              @relation(fields: [customerId], references: [id])
  customerKycDocuments CustomerKycDocument[]

  @@index([customerId])
  @@index([panNumber])
  @@index([kycVerifiedAt])
  @@index([expiresAt])
  @@map("customer_kyc")
}

model CustomerKycDocument {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid           String    @unique @default(uuid()) @db.Char(36)
  customerKycId  BigInt    @map("customer_kyc_id") @db.UnsignedBigInt
  documentTypeId Int       @map("document_type_id") @db.SmallInt
  kycProviderId  Int       @map("kyc_provider_id") @db.SmallInt
  fileName       String?   @map("file_name") @db.VarChar(255)
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  customerKyc  CustomerKyc @relation(fields: [customerKycId], references: [id])
  kycProvider  KycProvider @relation(fields: [kycProviderId], references: [id])
  documentType KycDocument @relation(fields: [documentTypeId], references: [id])

  @@index([customerKycId])
  @@map("customer_kyc_document")
}

// ============================================================
// LEAD
// ============================================================

model Lead {
  id                    BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                  String                 @unique @default(uuid()) @db.Char(36)
  customerId            BigInt                 @map("customer_id") @db.UnsignedBigInt
  email                 String?                @db.VarChar(100)
  emailVerificationType EmailVerificationType? @map("email_verification_type")
  leadStatusId          Int                    @default(1) @map("lead_status_id") @db.SmallInt
  sourceId              Int?                   @map("source_id")
  isActive              Boolean                @default(true) @map("is_active")
  expiresAt             DateTime?              @map("expires_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  customer     Customer      @relation(fields: [customerId], references: [id])
  leadStatus   LeadStatus    @relation(fields: [leadStatusId], references: [id])
  source       LeadSource?   @relation(fields: [sourceId], references: [id])
  leadDetail   LeadDetail?
  leadUtms     LeadUtm[]
  applications Application[]

  @@index([customerId, createdAt])
  @@index([email])
  @@index([leadStatusId])
  @@index([expiresAt])
  @@index([isActive])
  @@index([createdAt])
  @@map("lead")
}

model LeadDetail {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid             String    @unique @default(uuid()) @db.Char(36)
  leadId           BigInt    @unique @map("lead_id") @db.UnsignedBigInt
  fullName         String?   @map("full_name") @db.VarChar(100)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  genderId         Int?      @map("gender_id") @db.SmallInt
  panNumber        String?   @map("pan_number") @db.Char(10)
  cityId           Int?      @map("city_id")
  pincode          String?   @db.Char(6)
  addressLine1     String?   @map("address_line_1") @db.TinyText
  addressLine2     String?   @map("address_line_2") @db.TinyText
  occupationId     Int?      @map("occupation_id") @db.SmallInt
  netMonthlyIncome Decimal?  @map("net_monthly_income") @db.Decimal(12, 2)
  annualTurnover   Decimal?  @map("annual_turnover") @db.Decimal(12, 2)
  annualProfit     Decimal?  @map("annual_profit") @db.Decimal(12, 2)
  cibilConsentAt   DateTime? @map("cibil_consent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  lead       Lead        @relation(fields: [leadId], references: [id])
  gender     Gender?     @relation(fields: [genderId], references: [id])
  occupation Occupation? @relation(fields: [occupationId], references: [id])
  city       City?       @relation(fields: [cityId], references: [id])

  @@index([cityId])
  @@index([pincode])
  @@map("lead_detail")
}

model LeadUtm {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid        String   @unique @default(uuid()) @db.Char(36)
  leadId      BigInt   @map("lead_id") @db.UnsignedBigInt
  utmSource   String?  @map("utm_source") @db.VarChar(100)
  utmMedium   String?  @map("utm_medium") @db.VarChar(100)
  utmCampaign String?  @map("utm_campaign") @db.VarChar(100)
  utmTerm     String?  @map("utm_term") @db.VarChar(100)
  utmContent  String?  @map("utm_content") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_utm")
}

// ============================================================
// APPLICATION
// ============================================================

model Application {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                String    @unique @default(uuid()) @db.Char(36)
  customerId          BigInt    @map("customer_id") @db.UnsignedBigInt
  leadId              BigInt    @map("lead_id") @db.UnsignedBigInt
  applicationStatusId Int       @map("application_status_id") @db.SmallInt
  kycCompletedAt      DateTime? @map("kyc_completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  customer          Customer                 @relation(fields: [customerId], references: [id])
  lead              Lead                     @relation(fields: [leadId], references: [id])
  applicationStatus ApplicationStatus        @relation(fields: [applicationStatusId], references: [id])
  details           ApplicationDetails?
  eligibility       ApplicationEligibility?
  agreement         ApplicationAgreement?
  disbursement      ApplicationDisbursement?

  @@index([customerId, applicationStatusId])
  @@index([leadId])
  @@index([applicationStatusId])
  @@map("application")
}

model ApplicationDetails {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                 String    @unique @default(uuid()) @db.Char(36)
  applicationId        BigInt    @unique @map("application_id") @db.UnsignedBigInt
  reasonForLoanId      Int?      @map("reason_for_loan_id") @db.SmallInt
  loanAmount           Decimal?  @map("loan_amount") @db.Decimal(12, 2)
  loanTenure           Int?      @map("loan_tenure") @db.MediumInt
  interestRate         Decimal?  @map("interest_rate") @db.Decimal(5, 2)
  interestAmount       Decimal?  @map("interest_amount") @db.Decimal(12, 2)
  processingFee        Decimal?  @map("processing_fee") @db.Decimal(5, 2)
  processingFeeAmount  Decimal?  @map("processing_fee_amount") @db.Decimal(12, 2)
  gstAmount            Decimal?  @map("gst_amount") @db.Decimal(12, 2)
  loanDisbursementDate DateTime? @map("loan_disbursement_date") @db.Date
  loanMaturityDate     DateTime? @map("loan_maturity_date") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  application   Application    @relation(fields: [applicationId], references: [id])
  reasonForLoan ReasonForLoan? @relation(fields: [reasonForLoanId], references: [id])

  @@map("application_details")
}

model ApplicationEligibility {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  applicationId    BigInt   @unique @map("application_id") @db.UnsignedBigInt
  isEligible       Boolean  @map("is_eligible")
  approvedAmount   Decimal? @map("approved_amount") @db.Decimal(12, 2)
  cibilScore       Int?     @map("cibil_score")
  ineligibleReason String?  @map("ineligible_reason") @db.VarChar(500)
  checkedAt        DateTime @default(now()) @map("checked_at")
  createdAt        DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id])

  @@map("application_eligibility")
}

model ApplicationAgreement {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique @default(uuid()) @db.Char(36)
  applicationId BigInt    @unique @map("application_id") @db.UnsignedBigInt
  documentName  String?   @map("document_name") @db.VarChar(255)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  signedAt      DateTime? @map("signed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id])

  @@map("application_agreement")
}

model ApplicationDisbursement {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique @default(uuid()) @db.Char(36)
  applicationId BigInt    @unique @map("application_id") @db.UnsignedBigInt
  amount        Decimal?  @db.Decimal(12, 2)
  accountNumber String?   @map("account_number") @db.VarChar(20)
  ifscCode      String?   @map("ifsc_code") @db.VarChar(11)
  bankName      String?   @map("bank_name") @db.VarChar(100)
  utr           String?   @db.VarChar(50)
  disbursedAt   DateTime? @map("disbursed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id])

  @@map("application_disbursement")
}

// ============================================================
// ADMIN / USER
// ============================================================

model UserRole {
  id             Int     @id @default(autoincrement()) @db.SmallInt
  name           String  @unique @db.VarChar(50)
  hierarchyLevel Int     @default(1) @map("hierarchy_level") @db.SmallInt
  isActive       Boolean @map("is_active") @db.TinyInt
  users          User[]

  @@index([hierarchyLevel])
  @@map("user_role")
}

model User {
  id                      BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  fullName                String    @map("full_name") @db.VarChar(100)
  email                   String    @unique @db.VarChar(150)
  password                String?   @db.VarChar(255)
  roleId                  Int       @map("role_id") @db.SmallInt
  managerId               BigInt?   @map("manager_id") @db.UnsignedBigInt
  isActive                Boolean   @default(true) @map("is_active")
  invitationTokenHash     String?   @unique @map("invitation_token_hash") @db.Char(64)
  invitationSentAt        DateTime? @map("invitation_sent_at")
  invitationExpiresAt     DateTime? @map("invitation_expires_at")
  registrationCompletedAt DateTime? @map("registration_completed_at")
  lastLoginAt             DateTime? @map("last_login_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  userRole  UserRole? @relation(fields: [roleId], references: [id])
  manager   User?     @relation("LosUserManagers", fields: [managerId], references: [id])
  reportees User[]    @relation("LosUserManagers")

  @@index([managerId])
  @@index([roleId])
  @@index([isActive])
  @@map("user")
}
