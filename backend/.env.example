DATABASE_URL=mysql://moneyCash:moneyCash@db:3306/moneyCash
# If you run the API on your machine (not in Docker), point at published ports, e.g.:
# DATABASE_URL=mysql://moneyCash:moneyCash@127.0.0.1:3310/moneyCash
NODE_ENV=dev
# Customer auth uses opaque sessions in Redis (see CUSTOMER_SESSION_* settings), not JWTs in cookies.
# When the browser uses `https://api…` for JSON while the customer site is on `https://www…`, set the
# registrable domain so the session cookie is sent to both (required for `/auth/google/login` on www):
# CUSTOMER_AUTH_COOKIE_DOMAIN=moneycash.in
# Omit locally; never use `localhost` (browsers reject Domain=localhost).
# Required for customer OTP login and session validation:
REDIS_URL=redis://redis:6379
# Host-only dev (Compose maps 6385:6379): REDIS_URL=redis://127.0.0.1:6385
# Comma-separated browser origins (required for CORS in production; in non-production, localhost defaults apply if unset)
# Production example: CORS_ORIGINS=https://www.moneycash.in,https://moneycash.in
#
# Local troubleshooting: if the browser hits https://localhost:4001 but Nest only speaks HTTP, you get NS_ERROR_NET_RESET.
# Fix customer env: NEXT_PUBLIC_API_URL=/api (proxy) or http://127.0.0.1:4001/api — never https://localhost:4001 unless you terminate TLS on Nest.
# If you set CORS_ORIGINS here, include every dev origin you use (scheme + host + port), e.g. http://localhost:3021 for Docker-mapped customer.
CORS_ORIGINS=http://localhost:3010,http://localhost:3011,http://localhost:4001,http://127.0.0.1:3010,http://127.0.0.1:3011,http://127.0.0.1:4001
# If `true`, email OTP is not sent via SMTP; API returns `debugOtp` in JSON and the customer app shows it like mobile dev (do not use on public production).
# EMAIL_OTP_INLINE_ONLY=false
# If `true`, email OTP responses include `debugOtp` even in production (SMTP still used unless EMAIL_OTP_INLINE_ONLY). Prefer EMAIL_OTP_INLINE_ONLY for “no email” manual login.
# INCLUDE_DEBUG_OTP_EMAIL=false
# Per-IP Redis rate limits (fixed window). Defaults apply if unset.
# AUTH_RL_SEND_OTP_MAX=40
# AUTH_RL_SEND_OTP_WINDOW_SEC=3600
# AUTH_RL_VERIFY_OTP_MAX=120
# AUTH_RL_VERIFY_OTP_WINDOW_SEC=3600
# AUTH_RL_LOGOUT_MAX=60
# AUTH_RL_LOGOUT_WINDOW_SEC=3600
# AUTH_RL_SYNC_LEAD_EMAIL_MAX=30
# AUTH_RL_SYNC_LEAD_EMAIL_WINDOW_SEC=3600
# AUTH_RL_SAVE_LEAD_DETAILS_MAX=40
# AUTH_RL_SAVE_LEAD_DETAILS_WINDOW_SEC=3600
# AUTH_RL_PROFESSIONAL_DETAILS_MAX=30
# AUTH_RL_PROFESSIONAL_DETAILS_WINDOW_SEC=3600
# AUTH_RL_LOAN_SELECTION_MAX=30
# AUTH_RL_LOAN_SELECTION_WINDOW_SEC=3600
# AUTH_RL_KYC_DOCUMENTS_MAX=20
# AUTH_RL_KYC_DOCUMENTS_WINDOW_SEC=3600
# AUTH_RL_BANK_DETAILS_MAX=20
# AUTH_RL_BANK_DETAILS_WINDOW_SEC=3600
# Expose Swagger UI at /docs in production (default: off when NODE_ENV=production)
# ENABLE_OPENAPI_DOCS=false
# Optional: full public base URL for startup logs only (e.g. http://localhost:4001)
BACKEND_PUBLIC_BASE_URL=http://localhost:4001
DEFAULT_STAFF_PASSWORD=Secret123!
ENABLE_DEV_AUTH_REPAIR=true
PORT=4001
# Bind address: default 127.0.0.1 (host-only). Use 0.0.0.0 in containers. Repo `docker-compose.yml` sets HOST=0.0.0.0 for `backend` so `customer`/`los` can reach `http://backend:4001`.
# HOST=0.0.0.0
LOS_FRONTEND_URL=http://localhost:3020
LOS_INVITATION_EXPIRY_HOURS=24
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# --- Google Cloud Console (OAuth 2.0 Client → Web application) ---
# Authorized redirect URIs: must match GOOGLE_CALLBACK_URL byte-for-byte (scheme, host, path, no trailing slash unless you use one everywhere).
# Split prod (API on api., customer on www.): register BOTH of these if you use the legacy shim in `main.ts`, or only the first:
#   https://api.moneycash.in/api/auth/google/callback
#   https://api.moneycash.in/auth/google/callback
# Authorized JavaScript origins (recommended): https://www.moneycash.in  and  https://api.moneycash.in
# GOOGLE_CALLBACK_URL must be the SAME redirect URI you send in the auth request and in the token exchange (this codebase uses one env for both).
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/google/callback
# After Nest finishes OAuth, the browser is redirected here (customer Next app, not Google).
# Production: https://www.moneycash.in/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:3011/auth/google/callback
GOOGLE_STATE_SECRET=replace-with-a-secure-secret
# EmailService (nodemailer): put these in `backend/.env` (loaded at startup via `src/load-env.ts` + ConfigModule). If SMTP_HOST is unset, email OTPs are not sent (see dev console / LOG_OTP_TO_CONSOLE).
SMTP_HOST=mail.moneycash.in
SMTP_PORT=465
SMTP_SECURE=true
# Optional: cap how long nodemailer waits on TCP connect / socket (ms). Defaults are 25s / 60s so hung SMTP does not block `send-otp` for minutes while the browser times out.
# SMTP_CONNECTION_TIMEOUT_MS=25000
# SMTP_SOCKET_TIMEOUT_MS=60000
# If the API host times out connecting to SMTP but mail works from your laptop: (1) outbound 465 blocked — test on the server: `nc -zv $SMTP_HOST $SMTP_PORT` or `openssl s_client -connect $SMTP_HOST:$SMTP_PORT -brief`; (2) IPv6 route broken — try `SMTP_FAMILY=4`; (3) self-hosted mail must allow this server’s public IP (firewall / fail2ban).
# SMTP_FAMILY=4
SMTP_USER=saurabh@moneycash.in
SMTP_PASS=replace-with-your-email-password
MAIL_FROM_NAME=MoneyCash
MAIL_FROM_ADDRESS=saurabh@moneycash.in

# Tenacio PAN / vendor APIs (server-side only). All four are required for POST verify-pan → pan-nsdl.
# Base URL must end with …/services (full URL is base + /pan-nsdl).
#
# Use only these env names (underscores). Outbound HTTP uses Tenacio headers `client-id` and `x-api-key`:
#   `client-id`  ← TENACIO_CLIENT_ID
#   `x-api-key`  ← TENACIO_API_KEY
VENDOR_HOST=https://testapi.tenacio.io/api/v1/services
TENACIO_CLIENT_ID=your-client-id-from-tenacio
TENACIO_API_KEY=your-api-key-from-tenacio
# Sent as the `workflow-id` header. Different per environment (sandbox/prod) — get from Tenacio.
TENACIO_PAN_NSDL_WORKFLOW_ID=fe178ad3-b93e-423d-aa09-6885dfa69cd2
# Bureau soft pull (POST /api/vendor/tenacio/bureau). Recommended: full URL (avoids path join issues).
# Customer journey treats any HTTP status other than 200 as failure → thank-you / reject lead.
# TENACIO_CIBIL_URL=https://testapi.tenacio.io/api/v1/services/cibil-soft-pull
# TENACIO_CIBIL_URL=https://testapi.tenacio.io/api/v1/services/experian-soft-pull/services/experian-soft-pull
# Bureau `workflow-id` header — required for bureau pull (separate from PAN workflow).
# TENACIO_CIBIL_WORKFLOW_ID=98e9c5a1-855e-4b64-822a-06bd150ec34e
# Alternative: omit TENACIO_CIBIL_URL and append a path to VENDOR_HOST via TENACIO_CIBIL_SERVICE, e.g.
# TENACIO_CIBIL_SERVICE=experian-soft-pull/services/experian-soft-pull
# Optional short name for vendor_api_log.service_name when using TENACIO_CIBIL_URL: TENACIO_CIBIL_AUDIT_SERVICE=experian-soft-pull
# DigiLocker + Aadhaar (Tenacio)
# Step 1 — POST /api/auth/digilocker/init — body `{ "redirectUrl"?: "http://localhost:3021/kyc/digilocker-callback" }`
#   Tenacio payload: `{ "input": { "redirectUrl", "consent": true } }`. Response includes `digilockerLoginUrl` / `sessionToken` when parseable.
# Step 2 — POST /api/auth/digilocker/download-aadhaar — `{ "sessionToken": "<from step 1>", "consent": true }`
# CUSTOMER_PORTAL_BASE_URL — used to build default redirect + validate `redirectUrl` prefixes (also BACKEND_PUBLIC_BASE_URL).
CUSTOMER_PORTAL_BASE_URL=http://localhost:3021
# Optional: full redirect override (must still match allowed prefixes).
# DIGILOCKER_REDIRECT_URL=http://localhost:3021/kyc/digilocker-callback
# Path appended to CUSTOMER_PORTAL_BASE_URL when redirect is not sent and DIGILOCKER_REDIRECT_URL is unset:
# DIGILOCKER_REDIRECT_PATH=/kyc/digilocker-callback
# Comma-separated allowed URL prefixes for redirectUrl (merged with CUSTOMER_PORTAL_BASE_URL + BACKEND_PUBLIC_BASE_URL when set).
DIGILOCKER_REDIRECT_ALLOWED_PREFIXES=http://localhost:3021,http://127.0.0.1:3021,http://localhost:4001,http://127.0.0.1:4001
TENACIO_DIGILOCKER_WORKFLOW_ID=ee1a0260-1697-4035-bb6d-2a0b15544fb7
# Path under VENDOR_HOST (e.g. digilocker-generate-url) or use TENACIO_DIGILOCKER_URL for a full POST URL.
TENACIO_DIGILOCKER_SERVICE=digilocker-generate-url
# TENACIO_DIGILOCKER_URL=https://...
# TENACIO_DIGILOCKER_AUDIT_SERVICE=digilocker-generate-url
# Aadhaar download (sessionToken from step 1). Path under VENDOR_HOST or TENACIO_AADHAAR_DOWNLOAD_URL.
TENACIO_AADHAAR_DOWNLOAD_SERVICE=your-tenacio-aadhaar-download-path
# TENACIO_AADHAAR_DOWNLOAD_URL=https://...
# TENACIO_AADHAAR_DOWNLOAD_WORKFLOW_ID=...   # optional; defaults to TENACIO_DIGILOCKER_WORKFLOW_ID
# TENACIO_AADHAAR_DOWNLOAD_AUDIT_SERVICE=aadhaar-download
# AUTH_RL_DIGILOCKER_INIT_MAX=20
# AUTH_RL_DIGILOCKER_INIT_WINDOW_SEC=3600
# AUTH_RL_DIGILOCKER_AADHAAR_MAX=30
# AUTH_RL_DIGILOCKER_AADHAAR_WINDOW_SEC=3600
# On-disk KYC photos (default root: <backend cwd>/storage). Relative paths stored on `application`:
#   customer/<customer_uuid>/photos/aadhaar/<application_uuid>.<jpg|png>
#   customer/<customer_uuid>/photos/selfie/<application_uuid>.jpg
# KYC_FILES_ROOT=/var/lib/moneycash/storage
# Loan PDFs (Key Fact + Agreement) are stored under the same root:
#   customer/<customer_uuid>/loan-documents/<application_uuid>/key-fact-statement.pdf
#   customer/<customer_uuid>/loan-documents/<application_uuid>/loan-agreement.pdf
# Generation uses Word templates in backend/assets/loan-documents/templates/ and LibreOffice (`libreoffice` on PATH, or LIBREOFFICE_BIN).
# Face liveness (Tenacio). Stored selfie bytes are base64-encoded; the server sends `input.image` as `data:image/jpeg;base64,...` when needed.
# Outbound POST is skipped when: `KYC_LIVENESS_PAUSED=true`, or `TENACIO_LIVENESS_DISABLED=true`, or neither a full
# `TENACIO_LIVENESS_URL` (https://…) nor both `VENDOR_HOST` + non-empty `TENACIO_LIVENESS_SERVICE` are set.
# TENACIO_LIVENESS_DISABLED=true
# Path under VENDOR_HOST (e.g. `services/liveness`) or set TENACIO_LIVENESS_URL for a full POST URL.
# TENACIO_LIVENESS_SERVICE=services/liveness
# TENACIO_LIVENESS_URL=https://...
TENACIO_LIVENESS_WORKFLOW_ID=your-liveness-workflow-id
# TENACIO_LIVENESS_AUDIT_SERVICE=liveness
# IFSC details (customer bank step). POST body shape: `{ "input": { "ifscNumber", "consent": true } }`.
TENACIO_IFSC_LOOKUP_WORKFLOW_ID=your-ifsc-lookup-workflow-id
# Full URL must include scheme+host, e.g. https://testapi…/api/v1/services/ifsc-details — not just `ifsc-details`.
# If you only have a path slug, omit TENACIO_IFSC_LOOKUP_URL and set VENDOR_HOST + TENACIO_IFSC_LOOKUP_SERVICE instead.
# TENACIO_IFSC_LOOKUP_URL=https://...
# Or path under VENDOR_HOST (joined as `${VENDOR_HOST}/${TENACIO_IFSC_LOOKUP_SERVICE}`):
# TENACIO_IFSC_LOOKUP_SERVICE=ifsc-details
# TENACIO_IFSC_LOOKUP_AUDIT_SERVICE=ifsc-lookup
# Penny drop / account verification before disbursement. POST body includes mobile, account, IFSC, name, consent.
# Primary: set `VENDOR_HOST` (elsewhere in this file) + path slug below. Leave `TENACIO_PENNY_DROP_URL` unset unless you need a full https override.
TENACIO_PENNY_DROP_WORKFLOW_ID=your-penny-drop-workflow-id
TENACIO_PENNY_DROP_SERVICE=your-penny-drop-path-under-vendor-host
# TENACIO_PENNY_DROP_URL=https://testapi.example/api/v1/services/...   # optional full URL; if set, SERVICE is ignored for the target host/path
# TENACIO_PENNY_DROP_AUDIT_SERVICE=penny-drop
# When true/1/yes: no outbound Tenacio liveness; journey still needs DigiLocker + saved selfie (`livenessRequired: false` on `/auth/me`).
# KYC_LIVENESS_PAUSED=true
# Same effect for skipping vendor as `TENACIO_LIVENESS_DISABLED` / clearing `TENACIO_LIVENESS_SERVICE` (without a full liveness URL).
# AUTH_RL_VERIFY_PAN_MAX=40
# AUTH_RL_VERIFY_PAN_WINDOW_SEC=3600
# AUTH_RL_FETCH_BUREAU_MAX=30
# AUTH_RL_FETCH_BUREAU_WINDOW_SEC=3600
