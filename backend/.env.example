DATABASE_URL=mysql://moneyCash:moneyCash@db:3306/moneyCash
NODE_ENV=dev
# Customer auth uses opaque sessions in Redis (see CUSTOMER_SESSION_* settings), not JWTs in cookies.
# Required for customer OTP login and session validation:
REDIS_URL=redis://redis:6379
# Comma-separated browser origins (required for CORS; no defaults in code)
CORS_ORIGINS=http://localhost:3010,http://localhost:3011,http://localhost:4001,http://127.0.0.1:3010,http://127.0.0.1:3011,http://127.0.0.1:4001
# Optional: full public base URL for startup logs only (e.g. http://localhost:4001)
BACKEND_PUBLIC_BASE_URL=http://localhost:4001
DEFAULT_STAFF_PASSWORD=Secret123!
ENABLE_DEV_AUTH_REPAIR=true
PORT=4001
LOS_FRONTEND_URL=http://localhost:3010
LOS_INVITATION_EXPIRY_HOURS=24
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4001/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:3011/auth/google/callback
GOOGLE_STATE_SECRET=replace-with-a-secure-secret
SMTP_HOST=mail.moneycash.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=saurabh@moneycash.in
SMTP_PASS=replace-with-your-email-password
MAIL_FROM_NAME=MoneyCash
MAIL_FROM_ADDRESS=saurabh@moneycash.in
