DATABASE_URL=mysql://moneyCash:moneyCash@db:3306/moneyCash
# If you run the API on your machine (not in Docker), point at published ports, e.g.:
# DATABASE_URL=mysql://moneyCash:moneyCash@127.0.0.1:3310/moneyCash
NODE_ENV=dev
# Customer auth uses opaque sessions in Redis (see CUSTOMER_SESSION_* settings), not JWTs in cookies.
# Required for customer OTP login and session validation:
REDIS_URL=redis://redis:6379
# Host-only dev (Compose maps 6385:6379): REDIS_URL=redis://127.0.0.1:6385
# Comma-separated browser origins (required for CORS; no defaults in code)
CORS_ORIGINS=http://localhost:3010,http://localhost:3011,http://localhost:4001,http://127.0.0.1:3010,http://127.0.0.1:3011,http://127.0.0.1:4001
# Per-IP Redis rate limits (fixed window). Defaults apply if unset.
# AUTH_RL_SEND_OTP_MAX=40
# AUTH_RL_SEND_OTP_WINDOW_SEC=3600
# AUTH_RL_VERIFY_OTP_MAX=120
# AUTH_RL_VERIFY_OTP_WINDOW_SEC=3600
# AUTH_RL_LOGOUT_MAX=60
# AUTH_RL_LOGOUT_WINDOW_SEC=3600
# AUTH_RL_SYNC_LEAD_EMAIL_MAX=30
# AUTH_RL_SYNC_LEAD_EMAIL_WINDOW_SEC=3600
# AUTH_RL_SAVE_LEAD_DETAILS_MAX=40
# AUTH_RL_SAVE_LEAD_DETAILS_WINDOW_SEC=3600
# AUTH_RL_PROFESSIONAL_DETAILS_MAX=30
# AUTH_RL_PROFESSIONAL_DETAILS_WINDOW_SEC=3600
# AUTH_RL_LOAN_SELECTION_MAX=30
# AUTH_RL_LOAN_SELECTION_WINDOW_SEC=3600
# AUTH_RL_KYC_DOCUMENTS_MAX=20
# AUTH_RL_KYC_DOCUMENTS_WINDOW_SEC=3600
# AUTH_RL_BANK_DETAILS_MAX=20
# AUTH_RL_BANK_DETAILS_WINDOW_SEC=3600
# Expose Swagger UI at /docs in production (default: off when NODE_ENV=production)
# ENABLE_OPENAPI_DOCS=false
# Optional: full public base URL for startup logs only (e.g. http://localhost:4001)
BACKEND_PUBLIC_BASE_URL=http://localhost:4001
DEFAULT_STAFF_PASSWORD=Secret123!
ENABLE_DEV_AUTH_REPAIR=true
PORT=4001
LOS_FRONTEND_URL=http://localhost:3010
LOS_INVITATION_EXPIRY_HOURS=24
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Must match an authorized redirect URI in Google Cloud (Nest global prefix is `/api`).
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:3011/auth/google/callback
GOOGLE_STATE_SECRET=replace-with-a-secure-secret
# EmailService (nodemailer): put these in `backend/.env` (loaded at startup via `src/load-env.ts` + ConfigModule). If SMTP_HOST is unset, email OTPs are not sent (see dev console / LOG_OTP_TO_CONSOLE).
SMTP_HOST=mail.moneycash.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=saurabh@moneycash.in
SMTP_PASS=replace-with-your-email-password
MAIL_FROM_NAME=MoneyCash
MAIL_FROM_ADDRESS=saurabh@moneycash.in

# Tenacio PAN / vendor APIs (server-side only). All four are required for POST verify-pan → pan-nsdl.
# Base URL must end with …/services (full URL is base + /pan-nsdl).
#
# Use only these env names (underscores). Outbound HTTP uses Tenacio headers `client-id` and `x-api-key`:
#   `client-id`  ← TENACIO_CLIENT_ID
#   `x-api-key`  ← TENACIO_API_KEY
VENDOR_HOST=https://testapi.tenacio.io/api/v1/services
TENACIO_CLIENT_ID=your-client-id-from-tenacio
TENACIO_API_KEY=your-api-key-from-tenacio
# Sent as the `workflow-id` header. Different per environment (sandbox/prod) — get from Tenacio.
TENACIO_PAN_NSDL_WORKFLOW_ID=fe178ad3-b93e-423d-aa09-6885dfa69cd2
# Bureau soft pull (POST /api/vendor/tenacio/bureau). Recommended: full URL (avoids path join issues).
# TENACIO_CIBIL_URL=https://testapi.tenacio.io/api/v1/services/experian-soft-pull/services/experian-soft-pull
# Bureau `workflow-id` header — required for bureau pull (separate from PAN workflow).
# TENACIO_CIBIL_WORKFLOW_ID=98e9c5a1-855e-4b64-822a-06bd150ec34e
# Alternative: omit TENACIO_CIBIL_URL and append a path to VENDOR_HOST via TENACIO_CIBIL_SERVICE, e.g.
# TENACIO_CIBIL_SERVICE=experian-soft-pull/services/experian-soft-pull
# Optional short name for vendor_api_log.service_name when using TENACIO_CIBIL_URL: TENACIO_CIBIL_AUDIT_SERVICE=experian-soft-pull
# DigiLocker + Aadhaar (Tenacio)
# Step 1 — POST /api/auth/digilocker/init — body `{ "redirectUrl"?: "http://localhost:3021/kyc/digilocker-callback" }`
#   Tenacio payload: `{ "input": { "redirectUrl", "consent": true } }`. Response includes `digilockerLoginUrl` / `sessionToken` when parseable.
# Step 2 — POST /api/auth/digilocker/download-aadhaar — `{ "sessionToken": "<from step 1>", "consent": true }`
# CUSTOMER_PORTAL_BASE_URL — used to build default redirect + validate `redirectUrl` prefixes (also BACKEND_PUBLIC_BASE_URL).
CUSTOMER_PORTAL_BASE_URL=http://localhost:3021
# Optional: full redirect override (must still match allowed prefixes).
# DIGILOCKER_REDIRECT_URL=http://localhost:3021/kyc/digilocker-callback
# Path appended to CUSTOMER_PORTAL_BASE_URL when redirect is not sent and DIGILOCKER_REDIRECT_URL is unset:
# DIGILOCKER_REDIRECT_PATH=/kyc/digilocker-callback
# Comma-separated allowed URL prefixes for redirectUrl (merged with CUSTOMER_PORTAL_BASE_URL + BACKEND_PUBLIC_BASE_URL when set).
DIGILOCKER_REDIRECT_ALLOWED_PREFIXES=http://localhost:3021,http://127.0.0.1:3021,http://localhost:4001,http://127.0.0.1:4001
TENACIO_DIGILOCKER_WORKFLOW_ID=ee1a0260-1697-4035-bb6d-2a0b15544fb7
# Path under VENDOR_HOST (e.g. digilocker-generate-url) or use TENACIO_DIGILOCKER_URL for a full POST URL.
TENACIO_DIGILOCKER_SERVICE=digilocker-generate-url
# TENACIO_DIGILOCKER_URL=https://...
# TENACIO_DIGILOCKER_AUDIT_SERVICE=digilocker-generate-url
# Aadhaar download (sessionToken from step 1). Path under VENDOR_HOST or TENACIO_AADHAAR_DOWNLOAD_URL.
TENACIO_AADHAAR_DOWNLOAD_SERVICE=your-tenacio-aadhaar-download-path
# TENACIO_AADHAAR_DOWNLOAD_URL=https://...
# TENACIO_AADHAAR_DOWNLOAD_WORKFLOW_ID=...   # optional; defaults to TENACIO_DIGILOCKER_WORKFLOW_ID
# TENACIO_AADHAAR_DOWNLOAD_AUDIT_SERVICE=aadhaar-download
# AUTH_RL_DIGILOCKER_INIT_MAX=20
# AUTH_RL_DIGILOCKER_INIT_WINDOW_SEC=3600
# AUTH_RL_DIGILOCKER_AADHAAR_MAX=30
# AUTH_RL_DIGILOCKER_AADHAAR_WINDOW_SEC=3600
# AUTH_RL_VERIFY_PAN_MAX=40
# AUTH_RL_VERIFY_PAN_WINDOW_SEC=3600
# AUTH_RL_FETCH_BUREAU_MAX=30
# AUTH_RL_FETCH_BUREAU_WINDOW_SEC=3600
